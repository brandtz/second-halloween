# Firebase web app configuration is public, not a service-account credential.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Each event has a separate directory and saved walk.
VITE_EVENT_DATE=2026-11-01
# Local tests ONLY. Never enable on Netlify.
VITE_USE_EMULATORS=false
