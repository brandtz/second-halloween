{
  "name": "second-halloween",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.12.0 <27" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:integration": "firebase emulators:exec --project demo-second-halloween --only auth,firestore \"node --test tests/firestore.rules.test.mjs && playwright test\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "firebase-tools": "^15.34.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
